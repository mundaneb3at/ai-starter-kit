# Place this in your work\ folder if you use git there.
# Keeps archives and anything secret-shaped out of version control.

# Archived files (archive-don't-delete target)
_archive/

# Personal files the AI fills in about you - keep them off any repo you push
# (anchored to this folder's root, so the blank copies in templates\ stay tracked)
/ABOUT-ME.md
/FRUSTRATIONS.md

# Local secrets / credentials - never commit these
.env
*.secret
*.key
*.pem
secrets.*

# OS / editor noise
Thumbs.db
.DS_Store
.vscode/
